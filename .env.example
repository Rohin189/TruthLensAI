# ---- LLM ----
LLM_PROVIDER=huggingface        # huggingface | openai | anthropic
BASE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
HF_TOKEN=

# ---- Embeddings ----
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector Store ----
VECTOR_DB=faiss                 # faiss | chroma
VECTOR_DB_PATH=./data/vector_store

# ---- Retrieval ----
TOP_K=5

# ---- Trust Score Weights ----
WEIGHT_RETRIEVAL_RELEVANCE=0.25
WEIGHT_CLAIM_SUPPORT=0.35
WEIGHT_CITATION_COVERAGE=0.20
WEIGHT_MODEL_CONFIDENCE=0.20

# ---- Self-Correction ----
TRUST_SCORE_THRESHOLD=0.7
MAX_CORRECTION_ROUNDS=2

# ---- Backend ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Optional external APIs ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
